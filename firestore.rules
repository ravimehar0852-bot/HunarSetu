rules_version = '2';

service cloud.firestore {

  match /databases/{db}/documents {

    // ================================
    // HELPER FUNCTIONS
    // ================================

    function signed() {
      return request.auth != null;
    }

    function admin() {
      return signed() &&
        request.auth.token.admin == true;
    }

    function me(uid) {
      return signed() &&
        request.auth.uid == uid;
    }


    // ================================
    // USERS
    // ================================

    match /users/{uid} {

      // User can read own profile.
      // Admin can read all user profiles.
      allow read: if me(uid) || admin();


      // Customer / worker can create own account.
      allow create:
        if me(uid)
        && request.resource.data.role in ['customer', 'worker']
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'role',
          'createdAt'
        ]);


      // User can update own profile,
      // but cannot change protected role/status fields.
      allow update:
        if me(uid)
        && request.resource.data.role == resource.data.role
        && !request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasAny([
            'role',
            'status',
            'verified'
          ]);


      // Nobody can delete user profiles.
      allow delete: if admin();
    }


    // ================================
    // SERVICE CATEGORIES
    // ================================

    match /serviceCategories/{id} {

      allow read: if true;

      allow write: if admin();
    }


    // ================================
    // WORKER PROFILES
    // ================================

    match /workerProfiles/{id} {

      // Approved workers are publicly readable.
      // Worker can read own profile.
      // Admin can read all profiles.
      allow read:
        if resource.data.status == 'approved'
        || me(id)
        || admin();


      // Worker can create ONLY their own profile.
      // New profiles must start as pending.
      allow create:
        if me(id)
        && request.resource.data.status == 'pending'
        && request.resource.data.uid == request.auth.uid;


      // Admin can approve/reject/update workers.
      //
      // Worker can update their own profile,
      // but cannot change approval status.
      allow update:
        if admin()
        || (
          me(id)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.status == resource.data.status
        );


      // Worker profile cannot be deleted by worker.
      // Admin can delete if needed.
      allow delete:
        if admin();
    }


    // ================================
    // BOOKINGS
    // ================================

    match /bookings/{id} {

      // Customer, worker involved in booking,
      // or admin can read booking.
      allow read:
        if signed()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.workerId == request.auth.uid
          || admin()
        );


      // Booking creation/update will be handled
      // by the existing application / future Cloud Functions.
      allow write: if false;
    }


    // ================================
    // DENY EVERYTHING ELSE
    // ================================

    match /{document=**} {

      allow read, write: if false;
    }
  }
}
