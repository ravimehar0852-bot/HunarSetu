      // CREATE
      // -------------------------------------------------------
      //
      // House owner creates listing.
      //
      // Admin approval is required later.
      //
      allow create:
        if isHouseOwner()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.availability == 'available';


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------
      //
      // Owner can edit own listing.
      //
      // Owner CANNOT:
      // - approve own listing
      // - change ownerUid
      // - fake admin approval
      //
      // Admin can update everything.
      //

      allow update:
        if isAdmin()
        || (
          isHouseOwner()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.status == resource.data.status
        );


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------
      //
      // Owner can delete own listing.
      // Admin can delete any listing.
      //

      allow delete:
        if isAdmin()
        || (
          isHouseOwner()
          && resource.data.ownerUid == request.auth.uid
        );
    }


    // =========================================================
    // ENQUIRIES / VISIT REQUESTS
    // =========================================================
    //
    // Future student -> owner enquiry system.
    //
    // Example:
    //
    // Student:
    // "I want to visit this room."
    //
    // Owner:
    // "Visit confirmed."
    //

    match /enquiries/{enquiryId} {

      // Student, owner involved, or admin can read.
      allow read:
        if isAdmin()
        || (
          signedIn()
          && (
            resource.data.studentUid == request.auth.uid
            || resource.data.ownerUid == request.auth.uid
          )
        );


      // Student creates enquiry.
      allow create:
        if isStudent()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.ownerUid is string
