      //
      // Admin can update booking.
      //
      allow update:
        if isAdmin()
        || (
          signedIn()
          && resource.data.workerUid == request.auth.uid
          && request.resource.data.customerUid == resource.data.customerUid
          && request.resource.data.workerUid == resource.data.workerUid
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'status',
              'acceptedAt',
              'startedAt',
              'completionRequestedAt',
              'reviewRequestedAt'
            ])
        );


      allow delete:
        if isAdmin();
    }


    // =========================================================
    // DENY EVERYTHING ELSE
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
