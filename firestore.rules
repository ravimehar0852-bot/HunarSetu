rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed(){ return request.auth != null; }
    function admin(){ return signed() && request.auth.token.admin == true; }
    function me(uid){ return signed() && request.auth.uid == uid; }
    match /users/{uid} {
      allow read: if me(uid) || admin();
      // Role limited to customer/worker; admin comes only from a server-set custom claim.
      allow create: if me(uid) && request.resource.data.role in ['customer','worker']
        && request.resource.data.keys().hasOnly(['name','email','role','createdAt']);
      allow update: if me(uid) && request.resource.data.role == resource.data.role
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','status','verified']);
    }
    match /serviceCategories/{id} { allow read: if true; allow write: if admin(); }
    match /workerProfiles/{id} {
      allow read: if resource.data.status == 'approved' || me(id) || admin();
      allow create: if me(id) && request.resource.data.status == 'incomplete';
      allow update: if admin() || (me(id) && request.resource.data.status == resource.data.status
        && request.resource.data.verified == resource.data.verified);
    }
    match /bookings/{id} {
      allow read: if signed() && (resource.data.customerId == request.auth.uid || resource.data.workerId == request.auth.uid || admin());
      allow write: if false; // created and updated only via Cloud Functions (next phase)
    }
    match /{document=**} { allow read, write: if false; }
  }
}
