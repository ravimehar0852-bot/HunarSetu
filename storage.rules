rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    // =====================================================
    // PROPERTY / ROOM PHOTOS
    // =====================================================
    //
    // Future structure:
    //
    // listings/{ownerUid}/{listingId}/{fileName}
    //
    // Anyone can view approved/public listing photos.
    // Owner can upload only inside their own folder.
    //

    match /listings/{ownerUid}/{listingId}/{fileName} {

      // Public listing photos can be viewed.
      allow read: if true;

      // Owner can upload/update own listing photos.
      //
      // Maximum file size: 5 MB
      // Only image files allowed.
      //
      allow write:
        if request.auth != null
        && request.auth.uid == ownerUid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }


    // =====================================================
    // OWNER VERIFICATION DOCUMENTS
    // =====================================================
    //
    // Private verification files.
    //

    match /verification/{uid}/{fileName} {

      // Only owner or admin can read.
      allow read:
        if request.auth != null
        && (
          request.auth.uid == uid
          || request.auth.token.admin == true
        );

      // Owner can upload verification file.
      //
      // Maximum: 8 MB
      //
      allow write:
        if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024;
    }


    // =====================================================
    // OLD PUBLIC FILES
    // =====================================================
    //
    // Existing project compatibility.
    //

    match /public/{uid}/{fileName} {

      allow read: if true;

      allow write:
        if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }


    // =====================================================
    // DENY EVERYTHING ELSE
    // =====================================================

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
