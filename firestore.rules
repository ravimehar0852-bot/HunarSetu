          && request.resource.data.studentUid == resource.data.studentUid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.listingId == resource.data.listingId
        );


      allow delete:
        if isAdmin()
        || (
          isStudent()
          && resource.data.studentUid == request.auth.uid
        );
    }


    // =========================================================
    // NOTIFICATIONS
    // =========================================================
    //
    // Real in-app notification system.
    //
    // notifications/{notificationId}
    //

    match /notifications/{notificationId} {

      // User can read own notifications.
      // Admin can read all.
      allow read:
        if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );


      // Notifications should normally be created by
      // trusted backend/admin.
      //
      // Frontend users cannot create arbitrary notifications.
      //
      allow create:
        if isAdmin();


      // User can mark own notification as read.
      // Admin can update everything.
      allow update:
        if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'read'
            ])
        );


      allow delete:
        if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );
    }


    // =========================================================
    // FAVORITES
    // =========================================================
    //
    // Student saved rooms.
    //
    // favorites/{favoriteId}
    //

    match /favorites/{favoriteId} {

      allow read:
        if isAdmin()
        || (
          signedIn()
          && resource.data.studentUid == request.auth.uid
        );


      allow create:
        if isStudent()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.listingId is string;


      allow delete:
        if isAdmin()
        || (
          isStudent()
          && resource.data.studentUid == request.auth.uid
        );


      allow update:
        if false;
    }


    // =========================================================
    // REPORTS
    // =========================================================
    //
    // Student can report suspicious property/owner.
    //

    match /reports/{reportId} {

      allow read:
        if isAdmin()
        || (
          signedIn()
          && resource.data.reporterUid == request.auth.uid
        );


      allow create:
        if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetType in [
          'listing',
          'owner',
          'user'
        ]
        && request.resource.data.status == 'open';


      // Only admin manages report status.
      allow update:
        if isAdmin();


      allow delete:
        if isAdmin();
    }


    // =========================================================
    // FCM / PUSH NOTIFICATION TOKENS
    // =========================================================
    //
    // Later Firebase Cloud Messaging integration.
    //
    // fcmTokens/{tokenId}
    //

    match /fcmTokens/{tokenId} {

      allow read:
        if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );


      allow create:
        if signedIn()
        && request.resource.data.userId == request.auth.uid;


      allow update:
        if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;


      allow delete:
        if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );
    }


    // =========================================================
    // OLD BOOKINGS
    // =========================================================
    //
    // Existing project compatibility.
    //
    // This collection will later be replaced by enquiries.
    //

    match /bookings/{bookingId} {

      // Customer / worker / admin can read their booking.
