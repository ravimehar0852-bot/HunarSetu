rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /public/{uid}/{f} { allow read: if true; allow write: if request.auth.uid == uid && request.resource.size < 5*1024*1024 && request.resource.contentType.matches('image/.*'); }
    match /verification/{uid}/{f} { allow read: if request.auth.uid == uid || request.auth.token.admin == true; allow write: if request.auth.uid == uid && request.resource.size < 8*1024*1024; }
    match /{p=**} { allow read, write: if false; }
  }
}
